# ── SERVER ──
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# ── DATABASES ──
# Career Copilot's own Postgres (Neon or otherwise) — owns all cc_* tables.
CC_DATABASE_URL=postgresql://user:pass@host/career_copilot?sslmode=require

# The scraper's Postgres — READ-ONLY from this backend. Owns `jobs` and
# `scrape_runs`. This is intentionally a *different* database instance than
# CC_DATABASE_URL (see backend/README.md "Two-Database Architecture").
SCRAPER_DATABASE_URL=postgresql://user:pass@host/scraper_db?sslmode=require

# ── AUTH (Clerk) ──
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ── AI SERVICE (Part 3 — not built yet) ──
# Once ai/ exists, either import it directly (if same process/monorepo) or
# point this at an internal HTTP endpoint it exposes. Left blank = AI routes
# return 501 Not Implemented so the rest of the backend stays runnable.
AI_SERVICE_URL=

# ── NOTIFICATIONS ──
RESEND_API_KEY=re_xxx
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+10000000000

# ── ADMIN ──
# Simple shared-secret header for admin-only endpoints (cache clear, resource seed)
ADMIN_API_KEY=change_me
